#!/usr/bin/env bash
# Host wrapper for the containerized CAO stack.
set -euo pipefail
cd "$(dirname "$0")"

C="cao"   # service and container name

# A real one-word request per harness, run inside the container. Not a file test: the
# credentials file outlives the session it holds, so it was there while every Claude
# step of Grima#6 answered "Login expired" and the review came back with no report.
# `codex login status` is no better -- it says "Logged in" over tokens the API rejects
# with 401. Each probe costs a few seconds and one small request, and Claude's also
# renews an access token that has run out while the refresh token is still good.
PROBE_CLAUDE='timeout 60 claude -p ok --model claude-haiku-4-5-20251001 </dev/null >/dev/null 2>&1'
PROBE_CODEX='timeout 90 codex exec --ephemeral --skip-git-repo-check -s read-only -m gpt-6-astra -c model_reasoning_effort=low ok </dev/null >/dev/null 2>&1'

usage() {
  cat <<'USAGE'
usage: ./cao <command>

  up                start the stack (builds on first run)
  down              stop the stack (volumes and logins survive)
  login-gh          interactive GitHub login (also wires up git credentials)
  login-codex       interactive Codex login
  login-claude      interactive Claude Code login
                    (opencode/DeepSeek needs no login: set DEEPSEEK_API_KEY in .env)
  shell             bash shell inside the container
  launch [args]     start a supervisor session (passes args to `cao launch`)
  review <pr-url>   cross-review a PR with Claude, Codex and OpenCode;
                    the report lands in reports/<name>/<pr>/
  review <owner/name> <pr>
                    same, given repo and number separately
                    --timeout <seconds> raises the per-step budget (900 by default)
  ui                open the web UI
  logs              follow the server log
  status            container health and login state
USAGE
}

wait_healthy() {
  printf 'waiting for cao-server '
  for _ in $(seq 1 60); do
    if [ "$(docker inspect -f '{{.State.Health.Status}}' "$C" 2>/dev/null)" = "healthy" ]; then
      echo " ok -> http://localhost:9889"; return 0
    fi
    printf '.'; sleep 2
  done
  echo " timed out"; docker compose logs --tail 40 "$C"; return 1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  up)     docker compose up -d --build && wait_healthy ;;
  down)   docker compose down ;;
  shell)  docker compose exec "$C" bash ;;
  logs)   docker compose logs -f "$C" ;;
  ui)     open http://localhost:9889 ;;
  review)
    # The workflow clones and checks the PR out itself, so nothing needs to exist in
    # ~/workspace first. URL parsing lives here and not in the workflow: the workflow's
    # contract stays repo + number, and this is where a pasted link arrives.
    usage_review() { echo "usage: ./cao review <pr-url> | <owner/name> <pr-number> [--timeout <seconds>]" >&2; exit 1; }
    # --timeout is the workflow's step_timeout input: one harness on a 3.8k-line diff
    # took 20 minutes against the 900 s default and its findings arrived after the merge.
    step_timeout=""; pos=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout) step_timeout="${2:-}"; shift 2 || usage_review ;;
        *) pos+=("$1"); shift ;;
      esac
    done
    a="${pos[0]:-}"; b="${pos[1]:-}"
    [ -z "$a" ] && usage_review
    case "$a" in
      *github.com/*/pull/*)
        repo=$(printf '%s' "$a" | sed -E 's#.*github\.com/([^/]+/[^/]+)/pull/([0-9]+).*#\1#')
        pr=$(printf '%s' "$a" | sed -E 's#.*github\.com/([^/]+/[^/]+)/pull/([0-9]+).*#\2#') ;;
      */*) repo="$a"; pr="$b" ;;
      *)   usage_review ;;
    esac
    case "$pr" in ''|*[!0-9]*) usage_review ;; esac
    case "$step_timeout" in *[!0-9]*) usage_review ;; esac
    # Checked before anything is spent: a harness with a dead login ends every one of
    # its steps `completed` with nothing written, so the run takes its full twenty
    # minutes to fail, and with Claude out there is no arbiter and no report at all.
    docker compose exec -T "$C" sh -c "$PROBE_CLAUDE" \
      || { echo "claude is not logged in: run ./cao login-claude, then retry" >&2; exit 1; }
    docker compose exec -T "$C" sh -c "$PROBE_CODEX" \
      || { echo "codex is not logged in: run ./cao login-codex, then retry" >&2; exit 1; }
    # The container has no bind mount, so a report nobody copies out lives only in a
    # volume. Keyed by name and PR, the layout reports/ already holds.
    dest="reports/${repo##*/}/$pr"
    mkdir -p "$dest"
    rc=0
    docker compose exec -T "$C" cao workflow run pr_cross_review --wait --json \
      --input "repo=$repo" --input "pr=$pr" ${step_timeout:+--input "step_timeout=$step_timeout"} \
      | tee "$dest/run-summary.json" || rc=$?
    final=$(jq -r '.output.final_review // empty' "$dest/run-summary.json" 2>/dev/null || true)
    if [ -z "$final" ]; then
      echo "no report produced; run summary kept in $dest/run-summary.json" >&2
      exit 1
    fi
    docker compose cp "$C:$final" "$dest/final-review.md"
    # A rerun after new commits overwrites final-review.md in the container, so pin a
    # copy to the head it describes before the next run takes the name.
    head=$(docker compose exec -T "$C" cat "$(dirname "$final")/snapshot.json" 2>/dev/null \
      | jq -r '.head // empty' || true)
    if [ -n "$head" ]; then cp "$dest/final-review.md" "$dest/final-review.at-${head:0:8}.md"; fi
    echo "report: $dest/final-review.md"
    exit "$rc" ;;
  launch)
    docker compose exec -T "$C" sh -c 'cao-trust /home/cao/workspace /home/cao/workspace/*/'
    docker compose exec "$C" cao launch --agents code_supervisor "$@" ;;
  login-gh)     docker compose exec "$C" sh -c 'gh auth login && gh auth setup-git' ;;
  login-codex)  docker compose exec "$C" codex login ;;
  login-claude) docker compose exec "$C" claude ;;
  login)
    echo "no combined login: use ./cao login-gh, ./cao login-codex or ./cao login-claude" >&2
    exit 1 ;;
  status)
    docker compose ps
    docker compose exec -T "$C" sh -c '
      echo "user:   $(id -un) (uid $(id -u))"
      echo "tmux:   $(tmux -V)"
      echo "claude: $('"$PROBE_CLAUDE"' && echo authenticated || echo "NOT logged in")"
      echo "codex:  $('"$PROBE_CODEX"' && echo authenticated || echo "NOT logged in")"
      echo "gh:     $(gh auth status >/dev/null 2>&1 && echo authenticated || echo "NOT logged in")"
      echo "opencode: $(test -n "${DEEPSEEK_API_KEY:-}" && echo "DEEPSEEK_API_KEY present" || echo "DEEPSEEK_API_KEY MISSING")"' ;;
  *) usage; [ -z "$cmd" ] && exit 0 || exit 1 ;;
esac
