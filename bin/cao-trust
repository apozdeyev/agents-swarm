#!/usr/bin/env python3
"""Pre-accept Claude Code's and Codex's per-directory trust dialogs for the given paths.

A fresh container has no trust record for any path, so `claude` opens a blocking
"Do you trust the files in this folder?" prompt with "No, exit" preselected.
Claude then exits, CAO never sees a REPL, and `cao launch` dies on a read timeout.
Inside this container the sandbox *is* the boundary, so the prompt is pure noise.

Codex asks the same question, and CAO only dismisses it while it recognises the
wording. codex-cli 0.157 reworded it ("Trust this folder?"), so CAO waited out its
20s, pasted the task into the dialog -- whose Enter accepted it -- and the task was
lost: every first review of a new PR timed out its Codex step. A trusted path never
shows the dialog, whatever it says.
"""
import json
import os
import sys
import tomllib

CONFIG = os.path.expanduser("~/.claude.json")
CODEX_CONFIG = os.path.expanduser("~/.codex/config.toml")

try:
    with open(CONFIG) as fh:
        cfg = json.load(fh)
except (FileNotFoundError, ValueError):
    cfg = {}

cfg.setdefault("hasCompletedOnboarding", True)
projects = cfg.setdefault("projects", {})

changed = False
for raw in sys.argv[1:]:
    if not os.path.isdir(raw):
        continue
    entry = projects.setdefault(os.path.realpath(raw), {})
    if not entry.get("hasTrustDialogAccepted"):
        entry["hasTrustDialogAccepted"] = True
        changed = True

if changed:
    tmp = CONFIG + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CONFIG)

try:
    with open(CODEX_CONFIG, "rb") as fh:
        codex_projects = tomllib.load(fh).get("projects", {})
except FileNotFoundError:
    codex_projects = {}

# Appended as new tables rather than rewritten: the stdlib reads TOML but cannot write
# it, and the file carries Codex's own settings. A JSON string is a valid TOML basic
# string, so json.dumps quotes the path. A path already present is left as Codex wrote it.
missing = []
for raw in sys.argv[1:]:
    path = os.path.realpath(raw)
    if os.path.isdir(raw) and path not in codex_projects and path not in missing:
        missing.append(path)

if missing:
    with open(CODEX_CONFIG, "a") as fh:
        for path in missing:
            fh.write('\n[projects.%s]\ntrust_level = "trusted"\n' % json.dumps(path))
